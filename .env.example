DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hr_recruitment_dev
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Secrets — use strong random strings in production
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Gemini AI — used for resume parsing and ATS scoring
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq AI — free fallback when Gemini is rate-limited
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Deepgram — used for live transcription in the interviewer's meeting panel
# Get your key at: https://console.deepgram.com/
# Add to client/.env as: VITE_DEEPGRAM_API_KEY=
VITE_DEEPGRAM_API_KEY=

# SMTP (optional) — for interview notification emails
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
